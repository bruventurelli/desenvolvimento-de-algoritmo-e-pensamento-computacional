<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="calculador"/>
        <attribute name="authors" value="valentinorossi46"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-05 03:40:51 "/>
        <attribute name="created" value="dmFsZW50aW5vcm9zc2k0NjtXQURKT05HQTsyMDI2LTA5LTA1OyIwMjo1NToxNCAiOzM0MjU="/>
        <attribute name="edited" value="dmFsZW50aW5vcm9zc2k0NjtXQURKT05HQTsyMDI2LTA5LTA1OyIwMzo0MDo1MSAiOzM7MzUzMQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="opcao" type="Integer" array="False" size=""/>
            <declare name="num1, num2, num3, resultado" type="Real" array="False" size=""/>
            <declare name="int1, int2, i" type="Integer" array="False" size=""/>
            <do expression="opcao != 0">
                <output expression="&quot;Selecione a operacao desejada:&quot;" newline="True"/>
                <output expression="&quot;0. Sair&quot;" newline="True"/>
                <output expression="&quot;20. Fatorial&quot;" newline="True"/>
                <output expression="&quot;19. Potencia&quot;" newline="True"/>
                <output expression="&quot;18. Tabuada&quot;" newline="True"/>
                <output expression="&quot;17. Volume de um Cubo&quot;" newline="True"/>
                <output expression="&quot;16. Perimetro de um Retangulo&quot;" newline="True"/>
                <output expression="&quot;15. Juros Simples&quot;" newline="True"/>
                <output expression="&quot;14. Velocidade Media&quot;" newline="True"/>
                <output expression="&quot;13. Calcular Idade&quot;" newline="True"/>
                <output expression="&quot;12. Maior entre dois numeros&quot;" newline="True"/>
                <output expression="&quot;11. Par ou Impar&quot;" newline="True"/>
                <output expression="&quot;10. Conversao: Fahrenheit para Celsius&quot;" newline="True"/>
                <output expression="&quot;9. Conversao: Celsius para Fahrenheit&quot;" newline="True"/>
                <output expression="&quot;8. Porcentagem (X% de Y)&quot;" newline="True"/>
                <output expression="&quot;7. Media Aritmetica de 3 valores&quot;" newline="True"/>
                <output expression="&quot;6. Divisao&quot;" newline="True"/>
                <output expression="&quot;5. Multiplicacao&quot;" newline="True"/>
                <output expression="&quot;4. Subtracao&quot;" newline="True"/>
                <output expression="&quot;3. Soma&quot;" newline="True"/>
                <output expression="&quot;2. Calcular Area de um Retangulo (Obrigatorio)&quot;" newline="True"/>
                <output expression="&quot;1. Calcular IMC (Obrigatorio)&quot;" newline="True"/>
                <output expression="&quot; Sistema de Calculo - 20 Funcoes &quot;" newline="True"/>
                <input variable="opcao"/>
                <if expression="opcao == 1">
                    <then>
                        <output expression="&quot;Digite seu peso em kg:&quot;" newline="True"/>
                        <input variable="num1"/>
                        <output expression="&quot;Digite sua altura em metros:&quot;" newline="True"/>
                        <input variable="num2"/>
                        <assign variable="resultado" expression="num1 / (num2 * num2)"/>
                        <output expression="&quot;Resultado - Seu IMC &#233;: &quot; &amp; resultado" newline="True"/>
                    </then>
                    <else>
                        <if expression="opcao == 2">
                            <then>
                                <output expression="&quot;Digite a base do retangulo:&quot;" newline="True"/>
                                <input variable="num1"/>
                                <output expression="&quot;Digite a altura do retangulo:&quot;" newline="True"/>
                                <input variable="num2"/>
                                <assign variable="resultado" expression="num1 * num2"/>
                                <output expression="&quot;Resultado - A area e: &quot; &amp; resultado" newline="True"/>
                            </then>
                            <else>
                                <if expression="opcao == 3">
                                    <then>
                                        <output expression="&quot;Digite o primeiro numero:&quot;" newline="True"/>
                                        <input variable="num1"/>
                                        <output expression="&quot;Digite o segundo numero:&quot;" newline="True"/>
                                        <input variable="num2"/>
                                        <assign variable="resultado" expression="num1 + num2"/>
                                        <output expression="&quot;Resultado: &quot; &amp; resultado" newline="True"/>
                                    </then>
                                    <else>
                                        <if expression="opcao == 4">
                                            <then>
                                                <output expression="&quot;Digite o primeiro numero:&quot;" newline="True"/>
                                                <input variable="num1"/>
                                                <output expression="&quot;Digite o segundo numero:&quot;" newline="True"/>
                                                <input variable="num2"/>
                                                <assign variable="resultado" expression="num1 - num2"/>
                                                <output expression="&quot;Resultado: &quot; &amp; resultado" newline="True"/>
                                            </then>
                                            <else>
                                                <if expression="opcao == 5">
                                                    <then>
                                                        <output expression="&quot;Digite o primeiro numero:&quot;" newline="True"/>
                                                        <input variable="num1"/>
                                                        <output expression="&quot;Digite o segundo numero:&quot;" newline="True"/>
                                                        <input variable="num2"/>
                                                        <assign variable="resultado" expression="num1 * num2"/>
                                                        <output expression="&quot;Resultado: &quot; &amp; resultado" newline="True"/>
                                                    </then>
                                                    <else>
                                                        <if expression="opcao == 6">
                                                            <then>
                                                                <output expression="&quot;Digite o dividendo:&quot;" newline="True"/>
                                                                <input variable="num1"/>
                                                                <output expression="&quot;Digite o divisor:&quot;" newline="True"/>
                                                                <input variable="num2"/>
                                                                <assign variable="resultado" expression="num1 / num2"/>
                                                                <output expression="&quot;Resultado: &quot; &amp; resultado" newline="True"/>
                                                            </then>
                                                            <else>
                                                                <if expression="opcao == 7">
                                                                    <then>
                                                                        <output expression="&quot;Digite o primeiro valor:&quot;" newline="True"/>
                                                                        <input variable="num1"/>
                                                                        <output expression="&quot;Digite o segundo valor:&quot;" newline="True"/>
                                                                        <input variable="num2"/>
                                                                        <output expression="&quot;Digite o terceiro valor:&quot;" newline="True"/>
                                                                        <input variable="num3"/>
                                                                        <assign variable="resultado" expression="(num1 + num2 + num3) / 3"/>
                                                                        <output expression="&quot;Resultado - Media: &quot; &amp; resultado" newline="True"/>
                                                                    </then>
                                                                    <else>
                                                                        <if expression="opcao == 8">
                                                                            <then>
                                                                                <output expression="&quot;Digite a porcentagem (%):&quot;" newline="True"/>
                                                                                <input variable="num1"/>
                                                                                <output expression="&quot;Digite o valor total base:&quot;" newline="True"/>
                                                                                <input variable="num2"/>
                                                                                <assign variable="resultado" expression="(num1 / 100) * num2"/>
                                                                                <output expression="&quot;Resultado: &quot; &amp; resultado" newline="True"/>
                                                                            </then>
                                                                            <else>
                                                                                <if expression="opcao == 9">
                                                                                    <then>
                                                                                        <output expression="&quot;Graus Celsius:&quot;" newline="True"/>
                                                                                        <input variable="num1"/>
                                                                                        <assign variable="resultado" expression="(num1 * 9/5) + 32"/>
                                                                                        <output expression="&quot;Fahrenheit: &quot; &amp; resultado" newline="True"/>
                                                                                    </then>
                                                                                    <else>
                                                                                        <if expression="opcao == 10">
                                                                                            <then>
                                                                                                <output expression="&quot;Graus Fahrenheit:&quot;" newline="True"/>
                                                                                                <input variable="num1"/>
                                                                                                <assign variable="resultado" expression="(num1 - 32) * 5/9"/>
                                                                                                <output expression="&quot;Celsius: &quot; &amp; resultado" newline="True"/>
                                                                                            </then>
                                                                                            <else>
                                                                                                <if expression="opcao == 11">
                                                                                                    <then>
                                                                                                        <output expression="&quot;Digite um numero inteiro:&quot;" newline="True"/>
                                                                                                        <input variable="int1"/>
                                                                                                        <if expression="int1 % 2 == 0">
                                                                                                            <then>
                                                                                                                <output expression="&quot;O numero e PAR&quot;" newline="True"/>
                                                                                                            </then>
                                                                                                            <else>
                                                                                                                <output expression="&quot;O numero e IMPAR&quot;" newline="True"/>
                                                                                                            </else>
                                                                                                        </if>
                                                                                                    </then>
                                                                                                    <else>
                                                                                                        <if expression="opcao == 12">
                                                                                                            <then>
                                                                                                                <output expression="&quot;Primeiro numero:&quot;" newline="True"/>
                                                                                                                <input variable="num1"/>
                                                                                                                <output expression="&quot;Segundo numero:&quot;" newline="True"/>
                                                                                                                <input variable="num2"/>
                                                                                                                <if expression="num1 &gt; num2">
                                                                                                                    <then>
                                                                                                                        <output expression="&quot;O maior e: &quot; &amp; num1" newline="True"/>
                                                                                                                    </then>
                                                                                                                    <else>
                                                                                                                        <output expression="&quot;O maior e: &quot; &amp; num2" newline="True"/>
                                                                                                                    </else>
                                                                                                                </if>
                                                                                                            </then>
                                                                                                            <else>
                                                                                                                <if expression="opcao == 13">
                                                                                                                    <then>
                                                                                                                        <output expression="&quot;Ano de nascimento:&quot;" newline="True"/>
                                                                                                                        <input variable="int1"/>
                                                                                                                        <output expression="&quot;Ano atual:&quot;" newline="True"/>
                                                                                                                        <input variable="int2"/>
                                                                                                                        <output expression="&quot;Sua idade e: &quot; &amp; int2 - int1" newline="True"/>
                                                                                                                    </then>
                                                                                                                    <else>
                                                                                                                        <if expression="opcao == 14">
                                                                                                                            <then>
                                                                                                                                <output expression="&quot;Distancia percorrida (km):&quot;" newline="True"/>
                                                                                                                                <input variable="num1"/>
                                                                                                                                <output expression="&quot;Tempo de percurso (h):&quot;" newline="True"/>
                                                                                                                                <input variable="num2"/>
                                                                                                                                <assign variable="resultado" expression="num1 / num2"/>
                                                                                                                                <output expression="&quot;Velocidade media: &quot; &amp; resultado &amp; &quot; km/h&quot;" newline="True"/>
                                                                                                                            </then>
                                                                                                                            <else>
                                                                                                                                <if expression="opcao == 15">
                                                                                                                                    <then>
                                                                                                                                        <output expression="&quot;Capital inicial:&quot;" newline="True"/>
                                                                                                                                        <input variable="num1"/>
                                                                                                                                        <output expression="&quot;Taxa de juros (%):&quot;" newline="True"/>
                                                                                                                                        <input variable="num2"/>
                                                                                                                                        <output expression="&quot;Tempo (meses):&quot;" newline="True"/>
                                                                                                                                        <input variable="num3"/>
                                                                                                                                        <assign variable="resultado" expression="num1 * (num2 / 100) * num3"/>
                                                                                                                                        <output expression="&quot;Juros gerados: &quot; &amp; resultado" newline="True"/>
                                                                                                                                    </then>
                                                                                                                                    <else>
                                                                                                                                        <if expression="opcao == 16">
                                                                                                                                            <then>
                                                                                                                                                <output expression="&quot;Base:&quot;" newline="True"/>
                                                                                                                                                <input variable="num1"/>
                                                                                                                                                <output expression="&quot;Altura:&quot;" newline="True"/>
                                                                                                                                                <input variable="num2"/>
                                                                                                                                                <assign variable="resultado" expression="2 * (num1 + num2)"/>
                                                                                                                                                <output expression="&quot;Perimetro: &quot; &amp; resultado" newline="True"/>
                                                                                                                                            </then>
                                                                                                                                            <else>
                                                                                                                                                <if expression="opcao == 17">
                                                                                                                                                    <then>
                                                                                                                                                        <output expression="&quot;Tamanho da aresta:&quot;" newline="True"/>
                                                                                                                                                        <input variable="num1"/>
                                                                                                                                                        <assign variable="resultado" expression="num1 ^ 3"/>
                                                                                                                                                        <output expression="&quot;Volume: &quot; &amp; resultado" newline="True"/>
                                                                                                                                                    </then>
                                                                                                                                                    <else>
                                                                                                                                                        <if expression="opcao == 18">
                                                                                                                                                            <then>
                                                                                                                                                                <output expression="&quot;Digite o numero da tabuada:&quot;" newline="True"/>
                                                                                                                                                                <input variable="int1"/>
                                                                                                                                                                <for variable="i" start="1" end="10" direction="inc" step="1">
                                                                                                                                                                    <output expression="int1 &amp; &quot; x &quot; &amp; i &amp; &quot; = &quot; &amp; int1 * i" newline="True"/>
                                                                                                                                                                </for>
                                                                                                                                                            </then>
                                                                                                                                                            <else>
                                                                                                                                                                <if expression="opcao == 19">
                                                                                                                                                                    <then>
                                                                                                                                                                        <output expression="&quot;Valor da base:&quot;" newline="True"/>
                                                                                                                                                                        <input variable="num1"/>
                                                                                                                                                                        <output expression="&quot;Valor do expoente:&quot;" newline="True"/>
                                                                                                                                                                        <input variable="num2"/>
                                                                                                                                                                        <assign variable="resultado" expression="num1 ^ num2"/>
                                                                                                                                                                        <output expression="&quot;Resultado: &quot; &amp; resultado" newline="True"/>
                                                                                                                                                                    </then>
                                                                                                                                                                    <else>
                                                                                                                                                                        <if expression="opcao == 20">
                                                                                                                                                                            <then>
                                                                                                                                                                                <output expression="&quot;Numero inteiro para fatorial:&quot;" newline="True"/>
                                                                                                                                                                                <input variable="int1"/>
                                                                                                                                                                                <assign variable="int2" expression="1"/>
                                                                                                                                                                                <for variable="i" start="1" end="int1" direction="inc" step="1">
                                                                                                                                                                                    <assign variable="int2" expression="int2 * i"/>
                                                                                                                                                                                </for>
                                                                                                                                                                                <output expression="&quot;Fatorial: &quot; &amp; int2" newline="True"/>
                                                                                                                                                                            </then>
                                                                                                                                                                            <else/>
                                                                                                                                                                        </if>
                                                                                                                                                                    </else>
                                                                                                                                                                </if>
                                                                                                                                                            </else>
                                                                                                                                                        </if>
                                                                                                                                                    </else>
                                                                                                                                                </if>
                                                                                                                                            </else>
                                                                                                                                        </if>
                                                                                                                                    </else>
                                                                                                                                </if>
                                                                                                                            </else>
                                                                                                                        </if>
                                                                                                                    </else>
                                                                                                                </if>
                                                                                                            </else>
                                                                                                        </if>
                                                                                                    </else>
                                                                                                </if>
                                                                                            </else>
                                                                                        </if>
                                                                                    </else>
                                                                                </if>
                                                                            </else>
                                                                        </if>
                                                                    </else>
                                                                </if>
                                                            </else>
                                                        </if>
                                                    </else>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </do>
        </body>
    </function>
</flowgorithm>
